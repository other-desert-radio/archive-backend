#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f .env ]]; then
	echo "Missing .env. Copy .env.example to .env before starting the containers." >&2
	exit 1
fi

docker compose -f compose.yml -f compose.watch.yml up --build -d
docker compose -f compose.yml -f compose.watch.yml ps
./node_modules/.bin/vite build --watch
