{
	"name": "archive-backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/server.ts",
		"start": "bun src/server.ts",
		"admin:build": "vite build",
		"test": "bun run admin:build && bun test",
		"auth:generate": "auth generate --config src/auth/auth.ts --output docs/BETTER_AUTH_SCHEMA.sql",
		"db:migrate": "./scripts/migrate up",
		"db:migrate:all": "./scripts/run-migrations",
		"db:rollback": "./scripts/migrate down",
		"format": "./scripts/format",
		"lint": "./scripts/lint",
		"typecheck": "tsc --noEmit",
		"setup-hooks": "./scripts/setup-git-hooks"
	},
	"dependencies": {
		"better-auth": "^1.7.4",
		"fastify": "latest",
		"kysely": "latest",
		"pg": "latest",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/node": "latest",
		"@types/pg": "latest",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"auth": "^1.7.4",
		"markdownlint-cli2": "^0.23.2",
		"prettier": "^3.9.6",
		"typescript": "latest",
		"vite": "^8.3.0"
	}
}
