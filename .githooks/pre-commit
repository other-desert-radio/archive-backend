#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
markdown=()
source_files=()
while IFS= read -r -d '' file; do
	if ! git diff --quiet -- "$file"; then
		printf 'Cannot format partially staged file: %s\nStage the remaining changes, or stash the unstaged changes before committing.\n' "$file" >&2
		exit 1
	fi
	files+=("$file")
	case "$file" in
		*.md) markdown+=("./$file") ;;
		*) source_files+=("./$file") ;;
	esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ((${#source_files[@]})); then
	./node_modules/.bin/biome format --write --files-ignore-unknown=true --no-errors-on-unmatched "${source_files[@]}"
fi
if ((${#markdown[@]})); then
	./node_modules/.bin/prettier --prose-wrap always --write "${markdown[@]}"
fi
if ((${#files[@]})); then
	git add -- "${files[@]}"
fi
bun run lint
