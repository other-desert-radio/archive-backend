PORT=43827
BETTER_AUTH_SECRET=local-development-secret-do-not-use-in-production
BETTER_AUTH_URL=http://localhost:43827
# Optional comma-separated additional exact browser origins.
BETTER_AUTH_TRUSTED_ORIGINS=
POSTGRES_PORT=5432
POSTGRES_DB=archive
POSTGRES_USER=admin
POSTGRES_PASSWORD=archive_dev

# Archive publication settings.
ARCHIVE_SITE_REPOSITORY=git@github.com:other-desert-radio/archive-site.git
# Host checkout; relative paths resolve from the backend repository root.
ARCHIVE_CHECKOUT_PATH=../clean-archive-site
# Compose maps this mounted container path to ARCHIVE_CHECKOUT_PATH.
ARCHIVE_CONTAINER_CHECKOUT_PATH=/archive-site
# Use main on the server; local publication targets publish-dev.
ARCHIVE_PUBLISH_BRANCH=publish-dev
ARCHIVE_PUBLISH_ENABLED=true

# Used by scripts/setup-archive-publication to set checkout-local commit identity.
ARCHIVE_GIT_NAME=Other Desert Radio Archive
ARCHIVE_GIT_EMAIL=archive@otherdesertradio.com
# Runtime-only bind mounts, outside this repository/image. Key must have write access.
ARCHIVE_DEPLOY_KEY_PATH=../archive-publication-ssh/id_ed25519
ARCHIVE_KNOWN_HOSTS_PATH=../archive-publication-ssh/known_hosts
